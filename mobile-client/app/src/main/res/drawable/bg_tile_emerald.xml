<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_glow">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/tile_emerald_start"
                android:endColor="@color/tile_emerald_end" />
            <stroke
                android:width="1dp"
                android:color="@color/accent" />
            <padding
                android:left="14dp"
                android:top="14dp"
                android:right="14dp"
                android:bottom="14dp" />
        </shape>
    </item>
</ripple>
