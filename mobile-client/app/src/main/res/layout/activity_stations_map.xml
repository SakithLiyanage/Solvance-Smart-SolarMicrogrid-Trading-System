<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Official Google Maps SupportMapFragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/googleMapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Floating Header Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="14dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/surface_card"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Back Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseMap"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_arrow_left"
                app:iconTint="@color/text_primary"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                android:backgroundTint="@color/surface_card"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMapTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solar Microgrid Nodes"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_status_live"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live GPS Geolocation"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Station Count Badge -->
            <TextView
                android:id="@+id/tvMapStationCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 Active Hubs"
                android:textColor="#0369A1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_blue"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Station Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStationDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/surface_card"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1.2dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvMapStationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Colombo Central Solar Hub"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/tvMapHubStatusPill"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvMapHubStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Hub"
                    android:textColor="#065F46"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_mint"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvMapStationAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No. 45, Galle Road, Colombo"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/card_border"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvMapCapacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Capacity: 500 kWh"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_zap"
                    app:drawableTint="@color/accent"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/tvMapBatterySlots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14/20 Battery Slots Free"
                    android:textColor="#059669"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_battery_charging"
                    app:drawableTint="#059669"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavigateMaps"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="Start Navigation in Google Maps"
                app:icon="@drawable/ic_navigation"
                app:iconTint="@color/background_dark"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/accent"
                android:textColor="@color/background_dark"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>