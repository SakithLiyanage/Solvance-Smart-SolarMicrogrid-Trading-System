<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Header Security Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_live_pill"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_live"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURE ENERGY PASS"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Digital Booking Pass"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Monospace Res Number Pill with Copy Icon -->
        <LinearLayout
            android:id="@+id/layoutCopyResNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_chip"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvResNumberDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RES-12345678"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.04" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/primary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- High-Contrast QR Code Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQr"
            android:layout_width="260dp"
            android:layout_height="260dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/primary"
            app:strokeWidth="2.5dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:contentDescription="Secure Transaction QR Code" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCAN AT SOLAR STATION HUB"
                    android:textColor="@color/background_dark"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pending Approval Notice Card (Shown when status is Pending) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPendingNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/surface_card"
            app:strokeColor="@color/accent"
            app:strokeWidth="1.5dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/accent"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Awaiting Grid Operator Approval"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your scheduled appointment is currently pending review. Cryptographic QR dispatch token will be generated immediately once the station operator verifies node capacity."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status & Specs Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface_card"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BOOKING STATUS"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tvStatusDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Approved"
                        android:textColor="@color/badge_approved_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_approved"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_border"
                    android:layout_marginBottom="14dp" />

                <!-- Station Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_map_pin"
                        app:tint="@color/text_secondary"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tvStationDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Colombo Central Solar Hub"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Appointment Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/text_secondary"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tvScheduledDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scheduled: 2026-09-15 10:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Energy Spec -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivEnergyIconDetail"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_zap"
                        app:tint="@color/primary"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tvEnergyDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Energy: 15.0 kWh (DropOff)"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 12-Hour Cancellation Policy Rule Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/stat_active_start"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/primary"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="12-Hour Rule: Modifications and cancellations require at least 12 hours' advance notice per Microgrid policy."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Modify Booking Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditReservation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Modify Booking Schedule / Quota"
            app:icon="@drawable/ic_edit"
            app:iconTint="@color/accent"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/accent"
            app:cornerRadius="16dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="1.2dp"
            android:layout_marginBottom="10dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelReservation"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Cancel Booking"
                app:icon="@drawable/ic_x"
                app:iconTint="@color/danger"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/danger"
                app:cornerRadius="16dp"
                app:strokeColor="@color/danger"
                app:strokeWidth="1.2dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Dashboard"
                app:icon="@drawable/ic_arrow_left"
                app:iconTint="@color/background_dark"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/background_dark"
                app:cornerRadius="16dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/primary" />

    </LinearLayout>
</ScrollView>
