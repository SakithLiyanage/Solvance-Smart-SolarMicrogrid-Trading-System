<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <!-- ============================================================= -->
        <!-- 1. TOP APP BAR WITH BACK BUTTON & SCHEDULING BADGE            -->
        <!-- ============================================================= -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/text_primary"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="Go Back"
                android:padding="8dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <!-- Scheduling Policy Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_live_pill"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_status_live"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7-Day Window"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Screen Title & Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Power Trading Slot"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reserve battery swapping or solar grid charging. Instant encrypted verification pass."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- 2. MAIN BOOKING FORM CARD                                     -->
        <!-- ============================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/surface_card"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 1. Station Hub Picker -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT SOLAR STATION HUB *"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_search_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="18dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_map_pin"
                        app:tint="@color/primary"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Station Hub" />

                    <Spinner
                        android:id="@+id/spStations"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- 2. Energy Trade Type Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENERGY TRADE TYPE *"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgTradeType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_bottom_nav"
                    android:padding="6dp"
                    android:layout_marginBottom="18dp">

                    <RadioButton
                        android:id="@+id/rbDropOff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Drop-Off (Sell)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:checked="true"
                        android:buttonTint="@color/primary"
                        android:drawableStart="@drawable/ic_zap"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="6dp"
                        android:padding="8dp" />

                    <RadioButton
                        android:id="@+id/rbCharging"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Charging (Buy)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:buttonTint="@color/accent"
                        android:drawableStart="@drawable/ic_battery_charging"
                        android:drawableTint="@color/accent"
                        android:drawablePadding="6dp"
                        android:padding="8dp" />
                </RadioGroup>

                <!-- 3. Energy Amount Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENERGY AMOUNT (KWH) *"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Energy Amount (kWh)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@color/surface_dark"
                    app:hintTextColor="@color/primary"
                    android:textColorHint="@color/text_muted"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEnergyAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:inputType="numberDecimal"
                        android:text="15.0" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Quick Presets -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/chipKwh10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10 kWh"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_chip"
                        android:paddingVertical="7dp"
                        android:layout_marginEnd="4dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipKwh15"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="15 kWh"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_chip_active"
                        android:paddingVertical="7dp"
                        android:layout_marginHorizontal="2dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipKwh25"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="25 kWh"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_chip"
                        android:paddingVertical="7dp"
                        android:layout_marginHorizontal="2dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipKwh50"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="50 kWh"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_chip"
                        android:paddingVertical="7dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- 4. Appointment Schedule -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APPOINTMENT SCHEDULE *"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <!-- Date / Time Selectors -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickDate"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:text="Select Date"
                        app:icon="@drawable/ic_calendar"
                        app:iconTint="@color/primary"
                        app:iconSize="16dp"
                        app:iconGravity="textStart"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1.2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickTime"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:text="Select Time"
                        app:icon="@drawable/ic_clock"
                        app:iconTint="@color/accent"
                        app:iconSize="16dp"
                        app:iconGravity="textStart"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/accent"
                        app:strokeWidth="1.2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_execution_white_card"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/accent"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Scheduled Time" />

                    <TextView
                        android:id="@+id/tvSelectedDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scheduled: Tap Date &amp; Time above"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 5. Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmBooking"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Confirm &amp; Generate QR Pass"
                    app:icon="@drawable/ic_qr_code"
                    app:iconTint="@color/background_dark"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/background_dark"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/primary" />

    </LinearLayout>
</ScrollView>