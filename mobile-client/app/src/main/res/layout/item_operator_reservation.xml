<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/surface_card"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Res #, Trade Badge, Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tvOperatorStatusBadge"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvOperatorResNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RES-12345678"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvOperatorTradeType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Feed-In"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_stat_pending"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOperatorStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved"
                android:textColor="@color/badge_approved_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_approved"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E2E4A"
            android:layout_marginBottom="10dp" />

        <!-- Detail Rows -->
        <!-- Prosumer NIC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_user"
                app:tint="@color/text_muted"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prosumer NIC:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvOperatorProsumerNic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200012345678"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Station Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_map_pin"
                app:tint="@color/text_muted"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvOperatorStation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colombo Central Solar Hub"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Schedule and Energy Spec -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/text_muted"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvOperatorSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026-09-14 10:00"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_zap"
                    app:tint="@color/primary"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvOperatorEnergy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15.0 kWh"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons Container (Only for Pending / Approved) -->
        <LinearLayout
            android:id="@+id/layoutOperatorActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCardVerify"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Verify &amp; Complete"
                app:icon="@drawable/ic_check_circle"
                app:iconTint="@color/background_dark"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                android:textAllCaps="false"
                android:backgroundTint="@color/accent"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCardCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancel"
                app:icon="@drawable/ic_x"
                app:iconTint="@color/danger"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                android:textAllCaps="false"
                android:textColor="@color/danger"
                app:strokeColor="@color/danger"
                app:strokeWidth="1dp"
                android:textStyle="bold"
                android:textSize="12sp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Resolved message (Visible for Completed / Cancelled) -->
        <TextView
            android:id="@+id/tvOperatorResolvedMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completed &amp; Grid Synchronized"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
