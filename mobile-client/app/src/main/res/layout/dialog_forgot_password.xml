<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_ticket_pass_card"
    android:padding="22dp">

    <!-- ========================================================================= -->
    <!-- STEP 1: IDENTIFIER & CODE REQUEST                                         -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/layoutStep1Request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_shield_check"
                app:tint="#10B981"
                android:background="@drawable/bg_pill_mint"
                android:padding="7dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Security" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Recovery"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1 of 2: Identity Verification"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your registered National Identity Card (NIC) or Email address. We will dispatch a 6-digit verification code to protect your account against unauthorized access."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp" />

        <!-- Identifier Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="National ID (NIC) or Email"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etRecoveryIdentifier"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_search_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:inputType="text"
            android:hint="e.g. 199512345678 or prosumer@grid.lk"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStep1Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnCancelStep1"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_modify_time"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnSendOtp"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.2"
                android:text="Send Code"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_navigate_hub"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- STEP 2: CODE VERIFICATION & SET NEW PASSWORD                              -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/layoutStep2Verify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_shield_check"
                app:tint="#D97706"
                android:background="@drawable/bg_pill_mint"
                android:padding="7dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Security" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verify &amp; Reset"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2 of 2: Set New Password"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginBottom="12dp" />

        <!-- Notification Banner -->
        <TextView
            android:id="@+id/tvOtpDispatchedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verification code dispatched. Valid for 15 minutes."
            android:textColor="#059669"
            android:textSize="11sp"
            android:background="@drawable/bg_pill_mint"
            android:padding="8dp"
            android:layout_marginBottom="12dp" />

        <!-- 6-Digit OTP Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6-Digit Verification Code"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etRecoveryOtp"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_search_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:inputType="number"
            android:maxLength="6"
            android:hint="000000"
            android:layout_marginBottom="12dp" />

        <!-- New Password Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Password"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etRecoveryNewPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            android:inputType="textPassword"
            android:hint="Min 6 characters"
            android:layout_marginBottom="12dp" />

        <!-- Confirm Password Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm New Password"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etRecoveryConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            android:inputType="textPassword"
            android:hint="Re-type new password"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvStep2Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnBackToStep1"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Back"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_modify_time"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnVerifyAndReset"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.4"
                android:text="Save Password"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_navigate_hub"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
